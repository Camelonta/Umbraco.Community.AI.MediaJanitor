<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <StaticWebAssetBasePath>/</StaticWebAssetBasePath>
  </PropertyGroup>

  <PropertyGroup>
    <Product>Umbraco.Community.AI.MediaJanitor</Product>
    <PackageId>Umbraco.Community.AI.MediaJanitor</PackageId>
    <Version>1.0.1</Version>
    <Title>AI Media Janitor</Title>
    <Description>Adds an AI Media Assistant to the Umbraco (v17+) Media section. It finds images with missing alt text, generic file names, or in the wrong folder, and uses a vision-capable AI model (via Umbraco.AI) to suggest a better file name, alt text, caption, and folder. You review and edit every suggestion in a table, then apply the ones you want — nothing is changed automatically.</Description>
    <PackageTags>umbraco;umbraco-marketplace;ai;media;accessibility;alt-text</PackageTags>
    <Authors>Camelonta</Authors>
    <Copyright>$([System.DateTime]::UtcNow.ToString(`yyyy`)) © Camelonta</Copyright>
    <PackageProjectUrl>https://github.com/Camelonta/Umbraco.Community.AI.MediaJanitor</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Camelonta/Umbraco.Community.AI.MediaJanitor</RepositoryUrl>
    <PackageReadmeFile>README_nuget.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>logo.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Umbraco.AI.Core" />
    <PackageReference Include="Umbraco.Cms.Web.Website" />
    <PackageReference Include="Umbraco.Cms.Web.Common" />
    <PackageReference Include="Umbraco.Cms.Api.Common" />
    <PackageReference Include="Umbraco.Cms.Api.Management" />
  </ItemGroup>
  
  <ItemGroup>
    <!-- Dont include the client folder as part of packaging nuget build -->
    <Content Remove="Client\**" />

    <!-- However make the Umbraco-package.json included for dotnet pack or nuget package and visible to the solution -->
    <None Include="Client\public\umbraco-package.json" Pack="false" />
  </ItemGroup>
  
  <ItemGroup>
    <None Include="..\..\docs\README_nuget.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <!-- Package/Marketplace icon. Supply a square PNG (128x128 recommended) at docs\logo.png. -->
    <None Include="..\..\docs\logo.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>